{
  "openapi": "3.0.3",
  "info": {
    "title": "INO Explore API",
    "version": "1.0.0",
    "description": "Browse published reels, list products, and record interactions. Use Authorize with X-User-ID 1, 2, or 3 on a freshly seeded demo."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current API host"
    }
  ],
  "tags": [
    {
      "name": "Feed"
    },
    {
      "name": "Products"
    },
    {
      "name": "Interactions"
    },
    {
      "name": "Activity"
    },
    {
      "name": "Health"
    }
  ],
  "paths": {
    "/livez": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getLiveness",
        "summary": "Check liveness",
        "responses": {
          "200": {
            "description": "API process is serving",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                },
                "example": {
                  "status": "alive"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getReadiness",
        "summary": "Check PostgreSQL readiness",
        "responses": {
          "200": {
            "description": "Database is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                },
                "example": {
                  "status": "ready"
                }
              }
            }
          },
          "503": {
            "description": "Database is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                },
                "example": {
                  "status": "not_ready"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/feed": {
      "get": {
        "tags": [
          "Feed"
        ],
        "operationId": "getFeed",
        "summary": "Get the ranked Explore feed",
        "description": "Omit X-User-ID for the public feed. Reuse the same identity and category when following next_cursor. The cursor expires after ten minutes and covers up to 200 reels in the original order.",
        "security": [
          {},
          {
            "MockUser": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "description": "Maximum number of items on the page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "in": "query",
            "name": "category",
            "description": "Matches any attached product. Each item still includes all products.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "example": "outdoors"
          },
          {
            "in": "query",
            "name": "cursor",
            "description": "Use the next_cursor returned by the previous page.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2291
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked page of currently published reels",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidFeedRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidIdentity"
          },
          "410": {
            "$ref": "#/components/responses/ExpiredCursor"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ReadUnavailable"
          }
        }
      }
    },
    "/api/v1/reels/{id}/products": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReelID"
        }
      ],
      "get": {
        "tags": [
          "Products"
        ],
        "operationId": "listReelProducts",
        "summary": "List products attached to a reel",
        "description": "A published reel without products returns an empty list. Cached results can briefly reflect publication changes.",
        "responses": {
          "200": {
            "description": "Products ordered by display position and product ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidReelID"
          },
          "404": {
            "$ref": "#/components/responses/ReelNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ReadUnavailable"
          }
        }
      }
    },
    "/api/v1/reels/{id}/like": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReelID"
        }
      ],
      "post": {
        "tags": [
          "Interactions"
        ],
        "operationId": "setLike",
        "summary": "Set a Like",
        "security": [
          {
            "MockUser": []
          }
        ],
        "responses": {
          "204": {
            "description": "Sets one active Like for the caller. Repeating the request leaves one row."
          },
          "400": {
            "$ref": "#/components/responses/InvalidReelID"
          },
          "401": {
            "$ref": "#/components/responses/InvalidIdentity"
          },
          "404": {
            "$ref": "#/components/responses/ReelNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "tags": [
          "Interactions"
        ],
        "operationId": "clearLike",
        "summary": "Clear a Like",
        "security": [
          {
            "MockUser": []
          }
        ],
        "responses": {
          "204": {
            "description": "Clears the caller's Like. An already absent interaction also succeeds."
          },
          "400": {
            "$ref": "#/components/responses/InvalidReelID"
          },
          "401": {
            "$ref": "#/components/responses/InvalidIdentity"
          },
          "404": {
            "$ref": "#/components/responses/ReelNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/reels/{id}/save": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReelID"
        }
      ],
      "post": {
        "tags": [
          "Interactions"
        ],
        "operationId": "setSave",
        "summary": "Set a Save",
        "security": [
          {
            "MockUser": []
          }
        ],
        "responses": {
          "204": {
            "description": "Sets one active Save for the caller. Repeating the request leaves one row."
          },
          "400": {
            "$ref": "#/components/responses/InvalidReelID"
          },
          "401": {
            "$ref": "#/components/responses/InvalidIdentity"
          },
          "404": {
            "$ref": "#/components/responses/ReelNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "tags": [
          "Interactions"
        ],
        "operationId": "clearSave",
        "summary": "Clear a Save",
        "security": [
          {
            "MockUser": []
          }
        ],
        "responses": {
          "204": {
            "description": "Clears the caller's Save. An already absent interaction also succeeds."
          },
          "400": {
            "$ref": "#/components/responses/InvalidReelID"
          },
          "401": {
            "$ref": "#/components/responses/InvalidIdentity"
          },
          "404": {
            "$ref": "#/components/responses/ReelNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/reels/{id}/view": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReelID"
        }
      ],
      "post": {
        "tags": [
          "Interactions"
        ],
        "operationId": "recordView",
        "summary": "Record a reel view",
        "security": [
          {
            "MockUser": []
          }
        ],
        "responses": {
          "204": {
            "description": "At most one counted view per user and reel per UTC calendar day"
          },
          "400": {
            "$ref": "#/components/responses/InvalidReelID"
          },
          "401": {
            "$ref": "#/components/responses/InvalidIdentity"
          },
          "404": {
            "$ref": "#/components/responses/ReelNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/reels/{id}/share": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReelID"
        }
      ],
      "post": {
        "tags": [
          "Interactions"
        ],
        "operationId": "shareReel",
        "summary": "Share a reel with another user",
        "description": "Replaying the same sender, key, reel, and recipient returns the original receipt, including after archival. The JSON body is limited to 2 KiB.",
        "security": [
          {
            "MockUser": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "description": "Case-sensitive key scoped to the sender",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._~-]+$"
            },
            "required": true,
            "example": "share-001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareRequest"
              },
              "example": {
                "recipient_user_id": 2
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored share receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid reel ID, idempotency key, request body, or self-share",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Reel is missing or unpublished, or the recipient was not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "This sender already used the key with a different reel or recipient",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "idempotency_conflict"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidIdentity"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/reels/{id}/watch-sessions/{playback_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReelID"
        },
        {
          "in": "path",
          "name": "playback_id",
          "description": "Case-sensitive playback ID scoped to the caller",
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$"
          },
          "required": true,
          "example": "playback-001"
        }
      ],
      "put": {
        "tags": [
          "Interactions"
        ],
        "operationId": "updateWatchSession",
        "summary": "Record cumulative watch time",
        "description": "Retry with the same playback ID. An older report leaves the stored maximum intact. The JSON body is limited to 2 KiB.",
        "security": [
          {
            "MockUser": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WatchRequest"
              },
              "example": {
                "watched_ms": 10000
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored maximum watch time and watch percentage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchProgress"
                }
              }
            }
          },
          "400": {
            "description": "Invalid reel ID, playback ID, or request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The caller already used the playback ID for another reel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "playback_reel_conflict"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidIdentity"
          },
          "404": {
            "$ref": "#/components/responses/ReelNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/reels/{id}/interaction-state": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReelID"
        }
      ],
      "get": {
        "tags": [
          "Activity"
        ],
        "operationId": "getInteractionState",
        "summary": "Get the caller's Like and Save state",
        "security": [
          {
            "MockUser": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current cached or persisted interaction state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractionState"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidReelID"
          },
          "401": {
            "$ref": "#/components/responses/InvalidIdentity"
          },
          "404": {
            "$ref": "#/components/responses/ReelNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ReadUnavailable"
          }
        }
      }
    },
    "/api/v1/me/interactions/recent": {
      "get": {
        "tags": [
          "Activity"
        ],
        "operationId": "getRecentActivity",
        "summary": "Get the caller's recent activity",
        "security": [
          {
            "MockUser": []
          }
        ],
        "responses": {
          "200": {
            "description": "Up to 100 events ordered by UTC event time and then event ID, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidIdentity"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ReadUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MockUser": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-ID",
        "description": "Use the positive decimal ID of an existing demo user. This is mock identity for the assessment."
      }
    },
    "parameters": {
      "ReelID": {
        "in": "path",
        "name": "id",
        "description": "Reel ID",
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "required": true,
        "example": 1
      }
    },
    "responses": {
      "InvalidFeedRequest": {
        "description": "Invalid feed query parameters or invalid cursor",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InvalidReelID": {
        "description": "Invalid reel ID",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "invalid_reel_id"
            }
          }
        }
      },
      "InvalidIdentity": {
        "description": "Missing, malformed, or unknown mock identity",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "invalid_user_identity"
            }
          }
        }
      },
      "ReelNotFound": {
        "description": "Reel is missing, draft, or archived",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "reel_not_found"
            }
          }
        }
      },
      "ExpiredCursor": {
        "description": "The feed cursor expired",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "expired_cursor"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "internal_error"
            }
          }
        }
      },
      "ReadUnavailable": {
        "description": "The database read is unavailable or at capacity",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "read_unavailable"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "alive",
              "ready",
              "not_ready"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Creator": {
        "type": "object",
        "required": [
          "id",
          "display_name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "display_name": {
            "type": "string"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "title",
          "brand",
          "image_url",
          "price",
          "category"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Price in USD cents"
          },
          "category": {
            "type": "string",
            "example": "outdoors"
          }
        }
      },
      "ProductList": {
        "type": "object",
        "required": [
          "products"
        ],
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        }
      },
      "FeedReel": {
        "type": "object",
        "required": [
          "id",
          "caption",
          "video_url",
          "thumbnail_url",
          "created_at",
          "duration_ms",
          "like_count",
          "save_count",
          "view_count",
          "creator",
          "products"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "caption": {
            "type": "string"
          },
          "video_url": {
            "type": "string"
          },
          "thumbnail_url": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "like_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "save_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "view_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "creator": {
            "$ref": "#/components/schemas/Creator"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        }
      },
      "FeedPage": {
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedReel"
            }
          },
          "next_cursor": {
            "type": "string",
            "nullable": true,
            "description": "Null when the current browse is exhausted."
          }
        }
      },
      "ShareRequest": {
        "type": "object",
        "required": [
          "recipient_user_id"
        ],
        "properties": {
          "recipient_user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "ShareReceipt": {
        "type": "object",
        "required": [
          "id",
          "sender_id",
          "recipient_id",
          "reel_id",
          "idempotency_key",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "sender_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "recipient_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "reel_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WatchRequest": {
        "type": "object",
        "required": [
          "watched_ms"
        ],
        "properties": {
          "watched_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "WatchProgress": {
        "type": "object",
        "required": [
          "watched_ms",
          "watch_percentage"
        ],
        "properties": {
          "watched_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "watch_percentage": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "InteractionState": {
        "type": "object",
        "required": [
          "liked",
          "saved"
        ],
        "properties": {
          "liked": {
            "type": "boolean"
          },
          "saved": {
            "type": "boolean"
          }
        }
      },
      "ActivityEvent": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "reel_id",
          "type",
          "event_time"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "reel_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "like_added",
              "like_removed",
              "save_added",
              "save_removed",
              "view_counted",
              "share_created",
              "watch_interest"
            ]
          },
          "event_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ActivityList": {
        "type": "object",
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityEvent"
            }
          }
        }
      }
    }
  }
}
