# Optional: docker compose up works without this file or a .env file.
API_PORT=8080
POSTGRES_USER=ino
POSTGRES_PASSWORD=ino_local
POSTGRES_DB=ino
# Keep this aligned with POSTGRES_* above. URI-encode reserved characters.
DATABASE_URL=postgres://ino:ino_local@postgres:5432/ino?sslmode=disable
DB_STARTUP_TIMEOUT=30s
LOG_LEVEL=info
